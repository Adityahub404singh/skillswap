# SkillSwap Connect email delivery (existing mailer uses these)
EMAIL_USER=
EMAIL_PASS=
SMTP_USER=
SMTP_PASS=

# Jitsi as a Service / JWT-authenticated Jitsi deployment.
# Without all four values, the API intentionally returns joinUrl=null.
JITSI_DOMAIN=
JITSI_APP_ID=
JITSI_KEY_ID=
JITSI_PRIVATE_KEY=

# Frontend origin used in links
FRONTEND_URL=https://skillswap-india.vercel.app
